PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Optional: other website addresses allowed to call the API (comma-separated)
EXTRA_FRONTEND_URLS=http://localhost:3001

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pelicans_db

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Email alerts for the contact form (leave SMTP_HOST empty to turn off) ----
# Use the SMTP details from your email provider (hosting email, Google Workspace,
# Microsoft 365, Zoho, SendGrid, etc.). Test with: npm run test:email
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (SSL), false for port 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Who the alert comes from (usually the same mailbox as SMTP_USER)
MAIL_FROM="Pelicans Website <info@pelicanstechnologies.com>"
# Who receives the alerts (comma-separate for several people)
CONTACT_NOTIFY_TO=info@pelicanstechnologies.com
