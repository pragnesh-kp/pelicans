# Public address of the website. On the live server set it to
# https://pelicanstechnologies.com (used for canonical links, sitemap.xml and structured data).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Optional: backend URL used by the Next.js server (defaults to NEXT_PUBLIC_API_URL)
# API_URL=http://localhost:5000/api
